#!/usr/bin/env python3
"""bonsai - runs Ternary-Bonsai-2-27B (Q2_0 GGUF) under vLLM, set up the way that measured best on this RX 9070 (see Opti.md).

    bonsai launch                      start the server in this terminal (Ctrl+C stops it)
    bonsai launch --detach             start it in the background, wait until it answers, print the addresses
    bonsai launch --status             is it running, and where
    bonsai launch --stop               stop the one started with --detach
    bonsai launch --plan               say what would happen; nothing is started or written
    bonsai launch --show-key           print the API key

The defaults: MTP speculative decoding (the self-distilled MTP head, 3 draft tokens) with 100,000 tokens of context
(int4 KV cache, GPU memory 0.96), up to 4 requests at once, and GPU_MAX_HW_QUEUES=1 (Opti.md). Pick another draft with
--draft:
    --draft mtp      (default) ~106 t/s, 153,600 tokens of context
    --draft dflash   ~129 t/s, fastest, but only 63,488 tokens (the drafter and its KV cache take ~2 GiB)
    --draft none     ~56 t/s, longest context: 200,704 tokens It listens on 0.0.0.0,
so other machines can reach it, and so it asks for an API key (made once, kept in ~/.bonsai/api_key; `--no-api-key` serves
without one). The API is OpenAI-compatible: /v1/chat/completions, /v1/completions, model name "bonsai".

Other options (all of them: bonsai launch --help):
    --context max|32k|N       tokens of context per request (default max, fp8 / bf16: mtp 153,600 / 76,800,
                              none 200,704 / 100,352, dflash 63,488 / 30,720 or 69,632 / 34,816 with --max-seqs 1)
    --kv fp8|bf16             KV cache precision (bf16 is ~4% faster at decode but holds half the context)
    --max-seqs 1..4           requests served at once (default 4, which is also faster for one request)
    --prefill-interval N      while a request is generating, another prompt's prefill gets one step in N (default 32);
                              1 = vLLM's default, where a long prefill drops the running requests to ~2-13 t/s
    --draft mtp|dflash|none   speculative decoding: MTP (default, 150k), DFlash2 (fastest, 63k), none (200k)
    --vision                  accept images, up to 8 per request, scaled down to 4 MP at most. The vision encoder takes
                              ~0.9 GiB of VRAM, so the fp8 context ceilings drop: mtp 114,688, none 163,840, dflash 40,960
    --decode-deadline-ms MS   cap the predicted time of each step at MS ms, so prefill never stalls decodes (default off)
    --kv-evict off|lag|kvzip  KV cache eviction, passed as BONSAI_KV_EVICT (default off); --kv-evict-ratio R (> 1, default 2)
                              goes to BONSAI_KV_EVICT_RATIO
    --sparse-prefill TAU      lossy, --kv int4 only: BONSAI_SPARSE_PREFILL, TAU in [0.001, 1] (default 0.9);
                              --no-sparse-prefill for dense (lossless) prefill attention.
                              Measured at 0.9: solo 99k prefill
                              1089 -> 1294 t/s; 4 x 99k shared 292 -> 332 t/s each (TTFT 340 -> 298 s); long NLL 0.7073 -> 0.7110;
                              needle 4/4. Applies to the 16 full-attention layers when the context before the chunk is >= 16384 tokens
    --sparse-min-chunk N      BONSAI_SPARSE_MIN_CHUNK, N >= 1 (default unset)
    --host ADDR, --port N, --api-key-env NAME, --no-api-key

Everything it writes (the log, the pid, the key) goes to ~/.bonsai (or $BONSAI_HOME).
"""
from __future__ import annotations

import argparse
import json
import os
import secrets
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

HOME = Path.home()
REPO = Path(__file__).resolve().parents[2]  # bonsai/serve/bonsai lives in the vllm repo
VLLM = Path(os.environ.get("BONSAI_VLLM", REPO / ".venv/bin/vllm"))
MODEL = "prism-ml/Ternary-Bonsai-2-27B-gguf:Q2_0"
TOKENIZER = "Qwen/Qwen3.8-27B"
DFLASH_DRAFT = Path(os.environ.get("BONSAI_DFLASH", HOME / ".cache/dflash2-bonsai-nakli"))
MTP_GGUF = Path(os.environ.get("BONSAI_MTP_GGUF", HOME / ".cache/bonsai-27b-mtp-tuned/Ternary-Bonsai-2-27B-Q2_0-mtp.gguf"))
# Opti.md: at 0.95 GPU memory vLLM estimated 70,864 (fp8 KV) / 34,944 (bf16 KV) tokens with one request slot,
# and 64,272 (fp8) / 31,616 (bf16) with four slots (each slot also reserves its linear-attention state). These keep a small margin.
MAX_CONTEXT = {1: {"fp8": 69632, "bf16": 34816}, 4: {"fp8": 63488, "bf16": 30720}}
# Measured 2026-11-03 the same way: without a draft vLLM estimated 205,408 tokens (fp8 KV) with 1 or 4 slots;
# with the MTP head, 148,800 with 4 slots at 0.95 GPU memory and 161,600 at 0.96, hence 0.96 for MTP.
# bf16 is half of fp8 (not measured).
MAX_CONTEXT_NO_DRAFT = {"fp8": 200704, "bf16": 100352}
MAX_CONTEXT_MTP = {"fp8": 153600, "bf16": 76800}
# --vision: loads the vision encoder (Ternary-Bonsai-2-27B-mmproj-BF16.gguf, found next to the GGUF or in the HF repo)
# and lets each request carry up to VISION_IMAGES images. It costs VRAM, so the context ceilings are lower.
VISION_IMAGES = 8
# Larger images are scaled down to this many pixels (4 MP: a 2560x1440 screenshot still fits whole; ~4,096 image tokens).
# The preprocessor default is 16.7 MP (16,384 tokens), and vLLM reserves the encoder memory for that worst case.
VISION_MAX_PIXELS = 4 * 1024 * 1024
# Measured 2026-11-03 at 0.96 GPU memory, 4 slots: the encoder weights take ~0.9 GiB, and vLLM then estimated
# 121,000 tokens (fp8 KV) with MTP; 114,688 keeps the same ~5% margin as above. bf16 is half (not measured).
VISION_MAX_CONTEXT_MTP = {"fp8": 114688, "bf16": 57344}
# Same day: no draft (0.95), 174,172 tokens estimated for 163,840 asked; DFlash2 (0.95, 4 slots), 42,220 for 40,960 asked.
# DFlash2 with one slot was not measured, so it gets the 4-slot value (one slot only ever has more room).
VISION_MAX_CONTEXT_NO_DRAFT = {"fp8": 163840, "bf16": 81920}
VISION_MAX_CONTEXT = {1: {"fp8": 40960, "bf16": 20480}, 4: {"fp8": 40960, "bf16": 20480}}
GPU_MEMORY_MTP = 0.96
# --kv int4 (default): K 4-bit + V 3-bit HIP KV cache (232 B per token and kv head), GDN RecoverSSM, Model Runner V2.
# Built for 4 requests x 100k tokens on the RX 9070 (Opti.md section 9). vLLM's own memory profile reserves too much
# (activations/graphs), so the KV cache size is set exactly: blocks of 1840 tokens x 17 layers x 928 B, per request
# ceil(ctx / 1840) attention blocks + 6 GDN state blocks (2 per group of 16 layers, prefix-cache checkpoint included).
INT4_MAX_CONTEXT = 100000
INT4_BLOCK_TOKENS = 1840
INT4_BLOCK_BYTES = 17 * INT4_BLOCK_TOKENS * 928
GPU_MEMORY = 0.95
# --share-prefill: concurrent prompts each get this many prompt tokens per step (max-num-batched-tokens // max-num-seqs).
SHARE_PREFILL_BATCH_TOKENS = 512
# default sparse-prefill coverage with --kv int4 (Opti.md §13: +14-19% prefill, long NLL +0.5%, needle 4/4)
SPARSE_PREFILL_DEFAULT = 0.9
LOCAL_HOSTS = ("127.0.0.1", "localhost", "::1")


def say(msg: str = "") -> None:
    print(msg, flush=True)


def die(msg: str, hint: str = "") -> None:
    print("bonsai: " + msg, file=sys.stderr)
    if hint:
        print("        " + hint, file=sys.stderr)
    sys.exit(1)


def data_dir(a) -> Path:
    d = Path(a.data_dir or os.environ.get("BONSAI_HOME") or HOME / ".bonsai").expanduser()
    return d


def parse_context(text: str) -> str:
    t = text.strip().lower()
    if t in ("max", "full"):
        return "max"
    n = int(t[:-1]) * 1024 if t.endswith("k") else int(t)
    if n < 1024:
        raise argparse.ArgumentTypeError("the context must be at least 1024 tokens")
    return str(n)


def int4_kv_bytes(a, ctx: int) -> int:
    blocks = a.max_seqs * (-(-ctx // INT4_BLOCK_TOKENS) + 6)
    return int(blocks * INT4_BLOCK_BYTES * 1.003)


def context_tokens(a) -> int:
    if a.kv == "int4":
        if a.draft != "mtp":
            die("--kv int4 is built for --draft mtp", "use --kv fp8 for --draft none or dflash")
        if a.vision:
            die("--kv int4 does not support --vision yet", "use --kv fp8 --vision")
        limit = INT4_MAX_CONTEXT
        n = limit if a.context == "max" else int(a.context)
        if n > limit:
            die(f"--context {n}: --kv int4 is sized for at most {limit} tokens per request")
        return n
    if a.draft == "none":
        limit = (VISION_MAX_CONTEXT_NO_DRAFT if a.vision else MAX_CONTEXT_NO_DRAFT)[a.kv]
    elif a.draft == "mtp":
        limit = (VISION_MAX_CONTEXT_MTP if a.vision else MAX_CONTEXT_MTP)[a.kv]
    else:
        limit = (VISION_MAX_CONTEXT if a.vision else MAX_CONTEXT)[1 if a.max_seqs == 1 else 4][a.kv]
    if a.context == "max":
        return limit
    n = int(a.context)
    if n > limit:
        die(f"--context {n} does not fit in VRAM with the {a.kv} KV cache{' and --vision' if a.vision else ''} (max {limit})",
            "use --kv fp8 (twice the context), --draft mtp (150k) or --draft none (200k, slower generation)")
    return n


def pid_file(data: Path) -> Path:
    return data / "bonsai.pid"


def running_pid(data: Path) -> int | None:
    p = pid_file(data)
    if not p.exists():
        return None
    try:
        pid = int(p.read_text().split()[0])
        os.kill(pid, 0)
        return pid
    except (ValueError, ProcessLookupError, PermissionError):
        p.unlink(missing_ok=True)
        return None


def port_busy(host: str, port: int) -> bool:
    with socket.socket() as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1" if host in ("0.0.0.0", "::") else host, port)) == 0


def api_key(a, data: Path, create: bool) -> str | None:
    if a.api_key_env:
        key = os.environ.get(a.api_key_env)
        if not key:
            die(f"--api-key-env {a.api_key_env}: that variable is empty or not set")
        return key
    if a.no_api_key or a.host in LOCAL_HOSTS:
        return None
    f = data / "api_key"
    if f.exists():
        return f.read_text().strip()
    if not create:
        return None
    data.mkdir(parents=True, exist_ok=True)
    key = "sk-bonsai-" + secrets.token_urlsafe(24)
    f.write_text(key + "\n")
    f.chmod(0o600)
    return key


PLAN_ENV = ("GPU_MAX_HW_QUEUES", "VLLM_GGUF_DRAFT_VOCAB_ON_CPU", "BONSAI_KV_EVICT", "BONSAI_KV_EVICT_RATIO",
            "BONSAI_SPARSE_PREFILL", "BONSAI_SPARSE_MIN_CHUNK", "BONSAI_PF_VARIANT", "BONSAI_PF_W")


def parse_above_one(text: str) -> float:
    """argparse type: a finite float greater than 1."""
    value = float(text)
    if not 1 < value < float("inf"):
        raise argparse.ArgumentTypeError(f"must be a number above 1, not {text!r}")
    return value


def parse_positive_ms(text: str) -> float:
    """argparse type: a finite float greater than 0."""
    value = float(text)
    if not 0 < value < float("inf"):
        raise argparse.ArgumentTypeError(f"must be a positive number of milliseconds, not {text!r}")
    return value


def parse_tau(text: str) -> float:
    """argparse type: a float from 0.001 to 1."""
    value = float(text)
    if not 0.001 <= value <= 1:
        raise argparse.ArgumentTypeError(f"must be between 0.001 and 1, not {text!r}")
    return value


def parse_min_chunk(text: str) -> int:
    """argparse type: an integer of at least 1."""
    value = int(text)
    if value < 1:
        raise argparse.ArgumentTypeError(f"must be at least 1, not {text!r}")
    return value


def env_int(env: dict, name: str, default: int) -> int:
    """An integer environment variable, or exit when it is not one."""
    try:
        return int(env.get(name, str(default)))
    except ValueError:
        die(f"{name} must be an integer, got {env[name]!r}")


def check_prefill_env(a, env: dict) -> None:
    """Fail fast on inherited BONSAI_PF_* values that the attention plugin would reject or ignore."""
    variant = env_int(env, "BONSAI_PF_VARIANT", 0)
    if variant not in (0, 1):
        die(f"BONSAI_PF_VARIANT={variant} is not 0 or 1", "unset it or set 0 or 1")
    if env_int(env, "BONSAI_PF_W", 4) not in (4, 8):
        die(f"BONSAI_PF_W={env['BONSAI_PF_W']} is not 4 or 8", "unset it or set 4 or 8")
    if variant == 1 and (a.kv != "int4" or env.get("BONSAI_KV_V3", "1") != "1"):
        die("BONSAI_PF_VARIANT=1 is set, but the V3 int4 KV cache is not used", "unset BONSAI_PF_VARIANT or use --kv int4")
    sparse = a.sparse_prefill is not None or bool(env.get("BONSAI_SPARSE_PREFILL"))
    if variant == 1 and sparse:
        die("sparse prefill needs BONSAI_PF_VARIANT=0", "unset BONSAI_PF_VARIANT")
    if sparse and a.kv != "int4":
        die("sparse prefill only works with the int4 KV cache", "use --kv int4 or unset BONSAI_SPARSE_PREFILL")


def lan_addresses() -> list[str]:
    try:
        out = subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=5).stdout.split()
    except (OSError, subprocess.SubprocessError):
        return []
    return [a for a in out if ":" not in a]


def server_env(a) -> dict[str, str]:
    env = dict(os.environ)
    env["GPU_MAX_HW_QUEUES"] = "1"            # Opti.md: without it decode runs ~2x slower, at random
    if a.draft == "dflash":
        env["VLLM_GGUF_DRAFT_VOCAB_ON_CPU"] = "1"   # the draft's temporary vocab tables would not fit in 16 GB
    if a.kv == "int4":
        env["BONSAI_INT4_ATTN"] = "1"           # HIP attention + K4/V3 cache (plugin bonsai_int4_attn.py)
        env["BONSAI_GDN_RECOVERSSM"] = "1"      # one GDN state per request instead of 1 + k (bonsai_gdn_recoverssm.py)
        env["VLLM_USE_V2_MODEL_RUNNER"] = "1"   # RecoverSSM with prefix caching needs Model Runner V2
        env["BONSAI_MTP_WINDOW"] = str(a.mtp_window)   # draft-only sliding window (bonsai_mtp_window.py), 0 = off
        env["BONSAI_MTP_W8"] = "1"              # MTP head: rotated int8 + small-batch WMMA kernel (bonsai_mtp_w8.py)
        # own torch.compile cache: the plugin patches change the graphs but not vLLM's cache key
        env.setdefault("VLLM_CACHE_ROOT", str(HOME / ".cache" / "vllm-bonsai-int4"))
    if a.kv_evict != "off":
        env["BONSAI_KV_EVICT"] = a.kv_evict
        env["BONSAI_KV_EVICT_RATIO"] = str(a.kv_evict_ratio)
    if a.sparse_prefill is not None:
        env["BONSAI_SPARSE_PREFILL"] = str(a.sparse_prefill)
    if a.sparse_min_chunk is not None:
        env["BONSAI_SPARSE_MIN_CHUNK"] = str(a.sparse_min_chunk)
    return env


def share_prefill_args(a) -> list[str]:
    """The long-prefill threshold for --share-prefill; empty when off or when the user sets one."""
    flag = "--long-prefill-token-threshold"
    if not a.share_prefill or a.prefill_chunk:
        return []
    if any(arg == flag or arg.startswith(flag + "=") for arg in a.vllm_args or []):
        return []
    return [flag, str(SHARE_PREFILL_BATCH_TOKENS // a.max_seqs)]


def server_cmd(a, ctx: int, key: str | None) -> list[str]:
    model = str(MTP_GGUF) if a.draft == "mtp" else MODEL
    cmd = [str(VLLM), "serve", model, "--tokenizer", TOKENIZER, "--served-model-name", "bonsai",
           "--host", a.host, "--port", str(a.port), "--max-model-len", str(ctx),
           *(["--kv-cache-memory", str(int4_kv_bytes(a, ctx))] if a.kv == "int4" else
             ["--gpu-memory-utilization", str(GPU_MEMORY_MTP if a.draft == "mtp" else GPU_MEMORY)]),
           "--max-num-seqs", str(a.max_seqs),
           "--limit-mm-per-prompt", json.dumps({"image": VISION_IMAGES if a.vision else 0, "video": 0}),
           *(["--mm-processor-kwargs", json.dumps({"size": {"longest_edge": VISION_MAX_PIXELS, "shortest_edge": 65536}})]
             if a.vision else []),
           "--attention-backend", "TRITON_ATTN",
           "--reasoning-parser", "qwen3",
           "--enable-prompt-tokens-details",   # usage.prompt_tokens_details.cached_tokens (cache diagnosis)
           "--enable-auto-tool-choice", "--tool-call-parser", "qwen3_coder",
           # Measured 2026-11-04 (2 requests, 25k-token prompts): with the default (1), each decode step of a running
           # request waits for a 2048-token prefill chunk (~1.2 s), so it drops to ~13 t/s; with 32 it keeps ~42 t/s,
           # and the other prompt's prefill is ~9% longer. A request alone is not affected (pp unchanged).
           "--prefill-schedule-interval", str(a.prefill_interval if a.prefill_interval is not None
                                                else (6 if a.kv == "int4" else 32))]
    if a.kv == "fp8":
        cmd += ["--kv-cache-dtype", "fp8"]
    elif a.kv == "int4":
        cmd += ["--kv-cache-dtype", "int4_per_token_head", "--mamba-ssm-cache-dtype", "bfloat16",
                "--max-num-batched-tokens", str(SHARE_PREFILL_BATCH_TOKENS)]
    if a.draft == "dflash":
        cmd += ["--async-scheduling", "--speculative-config",
                json.dumps({"method": "dflash", "model": str(DFLASH_DRAFT), "num_speculative_tokens": 7,
                            "quantization": "fp8"})]
    elif a.draft == "mtp":
        cmd += ["--speculative-config", json.dumps({"method": "mtp", "num_speculative_tokens": a.spec_tokens})]
    if a.prefill_chunk:
        cmd += ["--long-prefill-token-threshold", str(a.prefill_chunk)]
    cmd += share_prefill_args(a)
    if a.decode_deadline_ms is not None:
        cmd += ["--decode-deadline-ms", str(a.decode_deadline_ms)]
    if a.no_async:
        cmd += ["--no-async-scheduling"]
    cmd += a.vllm_args or []
    if key:
        cmd += ["--api-key", key]
    return cmd


def check_files(a) -> None:
    if not VLLM.exists():
        die(f"vLLM not found at {VLLM}", "set $BONSAI_VLLM to the vllm executable of the venv with the GGUF plugin")
    if a.draft == "dflash" and not (DFLASH_DRAFT / "model.safetensors").exists():
        die(f"the DFlash2 drafter is missing ({DFLASH_DRAFT})", "Opti.md, section 'Reproduire', explains how to make it")
    if a.draft == "mtp" and not MTP_GGUF.exists():
        die(f"the MTP GGUF is missing ({MTP_GGUF})", "Opti.md, section 'Reproduire', explains how to make it")


def show_addresses(a, data: Path) -> None:
    host = a.host
    urls = [f"http://127.0.0.1:{a.port}/v1"]
    if host not in LOCAL_HOSTS:
        urls += [f"http://{ip}:{a.port}/v1" for ip in lan_addresses()]
    say("OpenAI API  " + "   ".join(urls) + "   (model name: bonsai)")
    key = api_key(a, data, create=False)
    say("API key     " + (key if key else "none"))


def cmd_stop(a) -> int:
    data = data_dir(a)
    pid = running_pid(data)
    if pid is None:
        say("no bonsai server is running (one started in a terminal is stopped with Ctrl+C there).")
        return 0
    say(f"stopping the server (pid {pid}) ...")
    os.killpg(pid, signal.SIGINT)
    for _ in range(60):
        time.sleep(1)
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            break
    else:
        say("bonsai: it did not stop in 60 s; sending SIGTERM")
        os.killpg(pid, signal.SIGTERM)
    pid_file(data).unlink(missing_ok=True)
    say("stopped.")
    return 0


def cmd_status(a) -> int:
    data = data_dir(a)
    pid = running_pid(data)
    if pid is None:
        say("not running (nothing started with --detach).")
        return 1
    state = (data / "state.json")
    info = json.loads(state.read_text()) if state.exists() else {}
    say(f"running, pid {pid}, port {info.get('port', a.port)}, context {info.get('context', '?')} tokens, "
        f"draft {info.get('draft', '?')}, KV {info.get('kv', '?')}, images {'yes' if info.get('vision') else 'no'}")
    return 0


def wait_ready(a, key: str | None, proc: subprocess.Popen, log: Path) -> None:
    url = f"http://127.0.0.1:{a.port}/v1/models"
    headers = {"Authorization": f"Bearer {key}"} if key else {}
    deadline = time.time() + 900
    while time.time() < deadline:
        if proc.poll() is not None:
            tail = log.read_text(errors="replace").splitlines()[-15:]
            die("the server stopped before it was ready; its last lines:\n  " + "\n  ".join(tail), f"full output: {log}")
        try:
            urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=2)
            return
        except OSError:
            time.sleep(3)
    die("the server did not answer within 15 minutes", f"see {log}")


def cmd_launch(a) -> int:
    if a.stop:
        return cmd_stop(a)
    if a.status:
        return cmd_status(a)
    data = data_dir(a)
    if a.show_key:
        key = api_key(a, data, create=False)
        say(key if key else "no API key (local host or --no-api-key)")
        return 0
    ctx = context_tokens(a)
    check_prefill_env(a, server_env(a))
    pid = running_pid(data)
    if pid is not None and not a.plan:
        die(f"a bonsai server is already running (pid {pid})", "stop it with: bonsai launch --stop")
    if port_busy(a.host, a.port) and not a.plan:
        die(f"port {a.port} is already in use", "pick another with --port")
    check_files(a)
    key = api_key(a, data, create=not a.plan)
    cmd = server_cmd(a, ctx, key)
    say(f"model     {MODEL}  (tokenizer {TOKENIZER})")
    say(f"draft     {a.draft}" + (f"  ({DFLASH_DRAFT})" if a.draft == "dflash" else ""))
    say(f"context   {ctx:,} tokens per request, KV cache {a.kv}, up to {a.max_seqs} requests at once")
    say(f"images    " + (f"yes, up to {VISION_IMAGES} per request" if a.vision else "no (text only; --vision turns them on)"))
    say(f"listen    {a.host}:{a.port}")
    needs_key = a.api_key_env or not (a.no_api_key or a.host in LOCAL_HOSTS)
    say("API key   " + ("from $" + a.api_key_env if a.api_key_env else f"yes ({data / 'api_key'})" if needs_key else "none"))
    if a.plan:
        env = server_env(a)
        say("\nenv       " + "  ".join(f"{k}={env[k]}" for k in PLAN_ENV if k in env))
        say("command   " + " ".join(c if " " not in c and "{" not in c else repr(c) for c in cmd).replace(key or "\0", "<key>"))
        return 0
    data.mkdir(parents=True, exist_ok=True)
    (data / "state.json").write_text(json.dumps({"port": a.port, "context": ctx, "draft": a.draft, "kv": a.kv,
                                                 "vision": a.vision}))
    env = server_env(a)
    if not a.detach:
        say("\nstarting (loading takes one to two minutes); Ctrl+C stops it\n")
        os.chdir(data)
        os.execvpe(cmd[0], cmd, env)
    log = data / "server.log"
    with open(log, "w") as out:
        proc = subprocess.Popen(cmd, cwd=data, env=env, stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
    pid_file(data).write_text(str(proc.pid))
    say(f"\nstarting in the background (pid {proc.pid}); loading takes one to two minutes ...")
    wait_ready(a, key, proc, log)
    say("ready.\n")
    show_addresses(a, data)
    say(f"\n  stop it:  bonsai launch --stop         output: {log}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="bonsai", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    l = sub.add_parser("launch", help="start / stop / inspect the inference server")
    l.add_argument("--detach", action="store_true", help="run in the background and wait until it answers")
    l.add_argument("--status", action="store_true", help="is it running")
    l.add_argument("--stop", action="store_true", help="stop the server started with --detach")
    l.add_argument("--plan", action="store_true", help="print what would run, start nothing")
    l.add_argument("--show-key", action="store_true", help="print the API key")
    l.add_argument("--context", type=parse_context, default="max", help="max (default), 32k, or a number of tokens")
    l.add_argument("--kv", choices=("int4", "fp8", "bf16"), default="int4",
                   help="KV cache: int4 (default; K 4-bit + V 3-bit, 4 x 100k tokens), fp8 or bf16")
    l.add_argument("--draft", choices=("mtp", "dflash", "none"), default="mtp",
                   help="speculative decoding: mtp (default, 150k context, ~106 t/s), dflash (63k, ~129 t/s), none (200k, ~56 t/s)")
    l.add_argument("--max-seqs", type=int, default=4, choices=(1, 2, 3, 4),
                   help="requests served at once (default 4; also faster for a single request, see Opti.md)")
    l.add_argument("--prefill-interval", type=int, default=None, metavar="N",
                   help="while requests are generating, admit another prompt's prefill once every N steps "
                        "(default 6 with --kv int4: ~630 t/s prefill at 95k while 3 others keep ~24 t/s; 32 otherwise; 1 = vLLM default)")
    l.add_argument("--prefill-chunk", type=int, default=None, metavar="T",
                   help="while other requests run, prefill at most T prompt tokens per step (mixed into their decode "
                        "steps; vLLM --long-prefill-token-threshold). Default: off")
    l.add_argument("--share-prefill", action=argparse.BooleanOptionalAction, default=True,
                   help="concurrent prompts prefill together, each at most 128 tokens per step (max-num-batched-tokens / "
                        "max-num-seqs; vLLM --long-prefill-token-threshold). Measured 4 x 99k cold prompts: each 290 t/s, "
                        "all first tokens at ~341 s (one by one: 95/187/282/375 s), total prefill +10%%, then 4 decoders "
                        "at ~71 t/s. Default on; --no-share-prefill turns it off")
    l.add_argument("--mtp-window", type=int, default=4096, metavar="N",
                   help="MTP head attends only the last N tokens (lossless; --kv int4 + --draft mtp; default 4096, 0 = off)")
    l.add_argument("--decode-deadline-ms", type=parse_positive_ms, default=None, metavar="MS",
                   help="cap the predicted time of each step at MS milliseconds (vLLM --decode-deadline-ms; default off)")
    l.add_argument("--kv-evict", choices=("off", "lag", "kvzip"), default="off",
                   help="KV cache eviction mode, passed as BONSAI_KV_EVICT (default off)")
    l.add_argument("--kv-evict-ratio", type=parse_above_one, default=2.0, metavar="R",
                   help="KV eviction ratio, above 1, passed as BONSAI_KV_EVICT_RATIO (default 2; used only with --kv-evict)")
    l.add_argument("--sparse-prefill", type=parse_tau, default=None, metavar="TAU",
                   help="lossy sparse prefill for --kv int4, passed as BONSAI_SPARSE_PREFILL, TAU in [0.001, 1] "
                        f"(default {SPARSE_PREFILL_DEFAULT} with --kv int4; --no-sparse-prefill turns it off). "
                        "Measured at 0.9: solo 99k prefill 1089 -> 1294 t/s; 4 x 99k shared 292 -> 332 t/s each "
                        "(TTFT 340 -> 298 s); long NLL 0.7073 -> 0.7110; needle 4/4. Applies to the 16 full-attention "
                        "layers when the context before the chunk is >= 16384 tokens")
    l.add_argument("--no-sparse-prefill", action="store_true", help="dense prefill attention (lossless)")
    l.add_argument("--sparse-min-chunk", type=parse_min_chunk, default=None, metavar="N",
                   help="passed as BONSAI_SPARSE_MIN_CHUNK, N >= 1 (default unset)")
    l.add_argument("--spec-tokens", type=int, default=3, metavar="K", help="MTP draft tokens per step (default 3)")
    l.add_argument("--vllm-arg", dest="vllm_args", action="append", metavar="ARG",
                   help="extra argument passed to vllm serve (repeatable)")
    l.add_argument("--no-async", action="store_true",
                   help="disable async scheduling (decodes then join every mixed step instead of every other one)")
    l.add_argument("--vision", action="store_true",
                   help=f"accept images (up to {VISION_IMAGES} per request); loads the vision encoder, ~1 GiB VRAM, less context")
    l.add_argument("--host", default="0.0.0.0")
    l.add_argument("--port", type=int, default=8000)
    l.add_argument("--api-key-env", help="read the API key from this environment variable")
    l.add_argument("--no-api-key", action="store_true", help="serve without an API key")
    l.add_argument("--data-dir", help=argparse.SUPPRESS)
    a = p.parse_args()
    if a.sparse_prefill is not None and a.kv != "int4":
        l.error("--sparse-prefill needs --kv int4")
    if a.no_sparse_prefill:
        if a.sparse_prefill is not None:
            l.error("--sparse-prefill and --no-sparse-prefill are exclusive")
    elif a.sparse_prefill is None and a.kv == "int4" and not os.environ.get("BONSAI_SPARSE_PREFILL") \
            and os.environ.get("BONSAI_PF_VARIANT", "0").strip() in ("", "0"):
        a.sparse_prefill = SPARSE_PREFILL_DEFAULT
    return cmd_launch(a)


if __name__ == "__main__":
    sys.exit(main())
